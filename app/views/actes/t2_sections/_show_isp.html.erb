              <th>Montant de la mesure (€)</th>
              <th>Enveloppe SGG (€)</th>
              <th>Consommation à date (€)</th>
              <th>Reste à consommer (€)</th>
            </tr>
            </thead>
            <tbody>
            <tr class="fr-cell--multiline">
              <td><%= Array(td.isp_cercle2_natures).join(', ').presence || 'Non renseigné' %></td>
              <td><%= number_to_currency(td.isp_cercle2_montant, unit: "€", format: "%n %u") %></td>
              <td><%= number_to_currency(td.isp_cercle2_enveloppe_sgg, unit: "€", format: "%n %u") %></td>
              <td><%= number_to_currency(td.isp_cercle2_consommation, unit: "€", format: "%n %u") %></td>
              <td>
                <% reste2 = (td.isp_cercle2_enveloppe_sgg.to_f - td.isp_cercle2_consommation.to_f).round(2) %>
                <%= number_to_currency(reste2, unit: "€", format: "%n %u") %>
