<%# locals: (acte:, td:) %>
<div class="fr-table fr-table--no-caption fr-table--no-scroll">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption>Marché (PSC)</caption>
          <thead>
            <tr class="fr-cell--multiline">
              <th>Montant au contrôle (€)</th>
              <th>Bénéficiaire</th>
              <% if acte.perimetre == 'organisme' %>
                <th>Budget exécutoire</th>
                <th>Opération budgétaire</th>
                <th>Délibération en CA nécessaire</th>
                <% if acte.deliberation_ca == true %>
                  <th>N° de délibération</th>
                  <th>Date de délibération</th>
                  <th>Observations sur la délibération</th>
                <% end %>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr class="fr-cell--multiline">
              <td><%= format_value(number_to_currency(acte.montant_ae, unit: "€", format: "%n %u")) %></td>
              <td><%= format_value(acte.beneficiaire) %></td>
              <% if acte.perimetre == 'organisme' %>
                <td><%= acte.budget_executoire ? 'Oui' : 'Non' %></td>
                <td><%= format_value(acte.operation_budgetaire) %></td>
                <td><%= acte.deliberation_ca ? 'Oui' : 'Non' %></td>
                <% if acte.deliberation_ca == true %>
                  <td><%= format_value(acte.numero_deliberation_ca) %></td>
                  <td><%= format_date_text(acte.date_deliberation_ca) %></td>
                  <td><%= format_value(acte.observations_deliberation_ca) %></td>
                <% end %>
              <% end %>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

