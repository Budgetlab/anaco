wb = xlsx_package.workbook

header_common_style = wb.styles.add_style(
  bg_color: "dae1f2",
  fg_color: "161616",
  b: true,
  alignment: { horizontal: :center, wrap_text: true },
  border: { style: :thin, color: "000000" },
  font_name: 'Calibri',
)

header_etat_style = wb.styles.add_style(
  bg_color: "c6efce",
  fg_color: "161616",
  b: true,
  alignment: { horizontal: :center, wrap_text: true },
  border: { style: :thin, color: "000000" },
  font_name: 'Calibri',
)

header_organisme_style = wb.styles.add_style(
  bg_color: "fce4d6",
  fg_color: "161616",
  b: true,
  alignment: { horizontal: :center, wrap_text: true },
  border: { style: :thin, color: "000000" },
  font_name: 'Calibri',
)

date_style = wb.styles.add_style(
  format_code: "dd/mm/yyyy",
  border: { style: :thin, color: "000000" },
  fg_color: "161616",
  font_name: 'Calibri',
)

number_style = wb.styles.add_style(
  format_code: "#,##0.00 €",
  border: { style: :thin, color: "000000" },
  fg_color: "161616",
  font_name: 'Calibri',
)

cell_style = wb.styles.add_style(
  border: { style: :thin, color: "000000" },
  fg_color: "161616",
  font_name: 'Calibri',
)

text_style = wb.styles.add_style(
  border: { style: :thin, color: "000000" },
  fg_color: "161616",
  font_name: 'Calibri',
  format_code: '@'
)

# Définition des colonnes : [libellé, périmètre (:common, :etat, :organisme)]
columns = [
  ['Controleur',                                      :common],     # A  1  admin only
  ['Périmètre',                                       :common],     # B  2
  ['Type Acte',                                       :common],     # C  3
  ['Exercice',                                        :common],     # D  4
  ['Numéro Acte',                                     :common],     # E  5
  ['Etat',                                            :common],     # F  6
  ['Pré-instruction',                                 :common],     # G  7
  ['Catégorie',                                       :organisme],  # H  8
  ['Nom organisme',                                   :organisme],  # I  9
  ['Programme',                                       :etat],       # J  10
  ['Centre financier',                                :etat],       # K  11
  ['Instructeur',                                     :common],     # L  12
  ['Nature',                                          :common],     # M  13
  ["Type d'engagement",                               :common],     # N  14
  ['Ordonnateur / Service ordonnateur',               :common],     # O  15
  ['Numéro Chorus / N° acte interne',                :common],     # P  16
  ['Objet',                                           :common],     # Q  17
  ['Bénéficiaire',                                    :common],     # R  18
  ["Nombre d'actes",                                  :common],     # S  19
  ['Montant de la mesure',                             :common],     # T  20
  ['Type de montant',                                 :organisme],  # U  21
  ['Montant total',                                   :common],     # V  22
  ['Titre/Catégorie',                                 :etat],       # W  23
  ['Action/Sous-action',                              :etat],       # X  24
  ['Code activité',                                   :etat],       # Y  25
  ['Numéro Marché',                                   :etat],       # Z  26
  ['Numéro TF / Affectation',                         :etat],       # AA 27
  ['Groupe de marchandises',                          :etat],       # AB 28
  ['Opération compte tiers',                          :organisme],  # AC 29
  ['Opération budgétaire',                            :organisme],  # AD 30
  ['Nature dépense / Affectation recette',            :organisme],  # AE 31
  ['Budget exécutoire',                               :organisme],  # AF 32
  ['Délibération CA',                                 :organisme],  # AG 33
  ['N° délibération',                                 :organisme],  # AH 34
  ['Date délibération',                               :organisme],  # AI 35
  ['Observations délibération',                       :organisme],  # AJ 36
  ['Destination',                                     :organisme],  # AK 37
  ['Nomenclature',                                    :organisme],  # AL 38
  ['Flux',                                            :organisme],  # AM 39
  ['Date création',                                   :common],     # AN 40
  ['Date de saisine',                                 :common],     # AO 41
  ['Suspension',                                      :common],     # AP 42
  ['Date de suspension',                              :common],     # AQ 43
  ['Date fin de suspension',                          :common],     # AR 44
  ['Motif suspension',                                :common],     # AS 45
  ['Date limite de réponse',                          :common],     # AT 46
  ['Proposition décision',                            :common],     # AU 47
  ['Décision finale',                                 :common],     # AV 48
  ['Valideur',                                        :common],     # AW 49
  ['Date clôture',                                    :common],     # AX 50
  ['Délai de traitement',                             :common],     # AY 51
  ['Type observations',                               :common],     # AZ 52
  ['Observations',                                    :common],     # BA 53
  ['Commentaire interne',                             :common],     # BB 54
  ['Gestion anticipée',                               :etat],       # BC 55
  ['Services votés',                                  :common],     # BD 56
  ['Engagement éligible à la gestion des SV',         :common],     # BE 57
  ['Acte programmé',                                  :common],     # BF 58
  ['Programmation initiale transmise',                :etat],       # BG 59
  ['Compatibilité avec programmation',                :etat],       # BH 60
  ['Autorisation tutelle',                            :organisme],  # BI 61
  ['Disponibilité crédits / fonds',                   :common],     # BJ 62
  ['Imputation dépense / recette',                    :common],     # BK 63
  ['Consommation crédits',                            :common],     # BL 64
  ['Soutenabilité',                                   :organisme],  # BM 65
  ['Conformité au seuil de contrôle',                 :organisme],  # BN 66
  ['Concordance recette/tiers',                       :organisme],  # BO 67
]

bool = ->(val) { val ? "Oui" : "Non" }

is_admin = @statut_user == 'admin'

# Story 3.3 — Partition HT2 / T2 : un onglet par titre.
# Les actes sans titre (legacy ou data inconsistency) sont traités comme HT2 (titre nil ≠ 'T2').
actes_ht2, actes_t2 = @actes_all.to_a.partition { |a| a.titre != 'T2' }

wb.add_worksheet(name: "HT2") do |sheet|
  headers = columns.each_with_index.filter_map do |(label, _), idx|
    next if idx == 0 && !is_admin
    label
  end

  header_styles = columns.each_with_index.filter_map do |(_, perimetre), idx|
    next if idx == 0 && !is_admin
    case perimetre
    when :etat      then header_etat_style
    when :organisme then header_organisme_style
    else                 header_common_style
    end
  end

  sheet.add_row headers, style: header_styles

  actes_ht2.each do |acte|
    last_susp = acte.suspensions.max_by { |s| s.date_suspension || s.created_at }
    last_susp_date     = last_susp&.date_suspension
    last_susp_end_date = last_susp&.date_reprise
    last_susp_motif    = Array(last_susp&.motif).join(", ")
    has_suspension     = last_susp.present? ? "Oui" : "Non"

    is_etat      = acte.perimetre == 'etat'
    is_organisme = acte.perimetre == 'organisme'
    is_depense   = acte.categorie_organisme == 'depense'
    is_recette   = acte.categorie_organisme == 'recette'
    is_tiers     = acte.operation_compte_tiers == true

    row_data = [
      # A  1  Controleur (admin only — filtered below)
      acte.user.nom,
      # B  2  Périmètre
      acte.perimetre&.capitalize,
      # C  3  Type Acte
      acte.type_acte,
      # D  4  Exercice
      acte.annee,
      # E  5  Numéro Acte
      acte.numero_formate,
      # F  6  Etat
      etat_acte(acte),
      # G  7  Pré-instruction
      bool.(acte.pre_instruction),
      # H  8  Catégorie  (organisme only)
      is_etat ? "N/A" : format_categorie_organisme(acte.categorie_organisme),
      # I  9  Nom organisme  (organisme only)
      is_etat ? "N/A" : acte.nom_organisme,
      # J  10 Programme  (état only)
      is_organisme ? "N/A" : acte.programme_principal&.numero,
      # K  11 Centre financier  (état only)
      is_organisme ? "N/A" : acte.centre_financier_code,
      # L  12 Instructeur
      acte.instructeur,
      # M  13 Nature
      acte.nature,
      # N  14 Type d'engagement  (N/A si recette organisme)
      (is_organisme && is_recette) ? "N/A" : acte.type_engagement,
      # O  15 Ordonnateur / Service ordonnateur  (N/A si recette organisme)
      (is_organisme && is_recette) ? "N/A" : acte.ordonnateur,
      # P  16 Numéro Chorus / N° acte interne
      acte.numero_chorus.to_s,
      # Q  17 Objet
      acte.objet,
      # R  18 Bénéficiaire
      acte.beneficiaire,
      # S  19 Nombre d'actes
      acte.nombre_actes && acte.nombre_actes > 1 ? acte.nombre_actes : 1,
      # T  20 Montant de la mesure
      acte.montant_ae,
      # U  21 Type de montant  (organisme only)
      is_etat ? "N/A" : acte.type_montant,
      # V  22 Montant total
      acte.montant_global,
      # W  23 Titre/Catégorie  (état only)
      is_organisme ? "N/A" : acte.categorie,
      # X  24 Action/Sous-action  (état only)
      is_organisme ? "N/A" : acte.action,
      # Y  25 Code activité  (état only)
      is_organisme ? "N/A" : acte.activite,
      # Z  26 Numéro Marché  (état only)
      is_organisme ? "N/A" : acte.numero_marche.to_s,
      # AA 27 Numéro TF / Affectation  (état only)
      is_organisme ? "N/A" : acte.numero_tf.to_s,
      # AB 28 Groupe de marchandises  (état only)
      is_organisme ? "N/A" : acte.groupe_marchandises,
      # AC 29 Opération compte tiers  (organisme only)
      is_etat ? "N/A" : bool.(acte.operation_compte_tiers),
      # AD 30 Opération budgétaire  (organisme only, N/A si compte tiers)
      is_etat ? "N/A" : (is_tiers ? "N/A" : acte.operation_budgetaire),
      # AE 31 Nature dépense / Affectation recette  (organisme only, N/A si compte tiers)
      is_etat ? "N/A" : (is_tiers ? "N/A" : acte.nature_categorie_organisme),
      # AF 32 Budget exécutoire  (organisme only)
      is_etat ? "N/A" : bool.(acte.budget_executoire),
      # AG 33 Délibération CA  (organisme only)
      is_etat ? "N/A" : bool.(acte.deliberation_ca),
      # AH 34 N° délibération  (organisme only)
      is_etat ? "N/A" : acte.numero_deliberation_ca,
      # AI 35 Date délibération  (organisme only)
      is_etat ? "N/A" : acte.date_deliberation_ca&.strftime('%d/%m/%Y'),
      # AJ 36 Observations délibération  (organisme only)
      is_etat ? "N/A" : acte.observations_deliberation_ca,
      # AK 37 Destination  (organisme only, N/A si recette)
      is_etat ? "N/A" : (is_recette ? "N/A" : acte.destination),
      # AL 38 Nomenclature  (organisme only)
      is_etat ? "N/A" : acte.nomenclature,
      # AM 39 Flux  (organisme only, N/A si recette)
      is_etat ? "N/A" : (is_recette ? "N/A" : acte.flux),
      # AN 40 Date création
      acte.created_at&.strftime('%d/%m/%Y'),
      # AO 41 Date de saisine
      acte.date_saisine&.strftime('%d/%m/%Y'),
      # AP 42 Suspension
      has_suspension,
      # AQ 43 Date de suspension
      last_susp_date&.strftime('%d/%m/%Y'),
      # AR 44 Date fin de suspension
      last_susp_end_date&.strftime('%d/%m/%Y'),
      # AS 45 Motif suspension
      last_susp_motif,
      # AT 46 Date limite de réponse
      acte.date_limite&.strftime('%d/%m/%Y'),
      # AU 47 Proposition décision
      acte.proposition_decision,
      # AV 48 Décision finale
      acte.decision_finale,
      # AW 49 Valideur
      acte.valideur,
      # AX 50 Date clôture
      acte.date_cloture&.strftime('%d/%m/%Y'),
      # AY 51 Délai de traitement
      acte.delai_traitement,
      # AZ 52 Type observations
      (acte.type_observations&.join(", ") if acte.type_observations.present?),
      # BA 53 Observations
      acte.observations,
      # BB 54 Commentaire interne
      acte.commentaire_proposition_decision,
      # BC 55 Gestion anticipée  (état only)
      is_organisme ? "N/A" : bool.(acte.gestion_anticipee),
      # BD 56 Services votés
      bool.(acte.services_votes),
      # BE 57 Engagement éligible gestion SV  (N/A si recette organisme ou services_votes false)
      (is_organisme && is_recette) ? "N/A" : (acte.services_votes ? bool.(acte.programmation) : "N/A"),
      # BF 58 Acte programmé
      bool.(acte.programmation_prevue),
      # BG 59 Programmation initiale transmise  (état only)
      is_organisme ? "N/A" : bool.(acte.avis_programmation),
      # BH 60 Compatibilité avec programmation  (état only, N/A si avis_programmation false)
      is_organisme ? "N/A" : (acte.avis_programmation ? bool.(acte.programmation) : "N/A"),
      # BI 61 Autorisation tutelle  (organisme only, N/A si budget_executoire true)
      is_etat ? "N/A" : (acte.budget_executoire ? "N/A" : bool.(acte.autorisation_tutelle)),
      # BJ 62 Disponibilité crédits  (N/A si recette organisme)
      (is_organisme && is_recette) ? "N/A" : bool.(acte.disponibilite_credits),
      # BK 63 Imputation dépense  (N/A si compte tiers)
      is_tiers ? "N/A" : bool.(acte.imputation_depense),
      # BL 64 Consommation crédits  (N/A si recette organisme)
      (is_organisme && is_recette) ? "N/A" : bool.(acte.consommation_credits),
      # BM 65 Soutenabilité  (organisme only, N/A si compte tiers)
      is_etat ? "N/A" : (is_tiers ? "N/A" : bool.(acte.soutenabilite)),
      # BN 66 Conformité au seuil  (organisme only)
      is_etat ? "N/A" : bool.(acte.conformite),
      # BO 67 Concordance recette/tiers  (organisme + recette + tiers uniquement)
      (is_organisme && is_recette && is_tiers) ? bool.(acte.concordance_recettes_tiers) : "N/A",
    ]

    # Retirer la colonne Controleur si non-admin
    row_data = row_data[1..] unless is_admin

    col_count = row_data.length
    styles = Array.new(col_count, cell_style)
    types  = Array.new(col_count, :string)

    # Index dans row_data (après suppression éventuelle de Controleur)
    idx_exercice      = is_admin ? 3  : 2
    idx_montant_ae    = is_admin ? 19 : 18
    idx_montant_total = is_admin ? 21 : 20
    idx_nb_actes      = is_admin ? 18 : 17
    idx_delai         = is_admin ? 50 : 49
    idx_chorus        = is_admin ? 15 : 14
    idx_marche        = is_admin ? 25 : 24
    idx_tf            = is_admin ? 26 : 25

    styles[idx_montant_ae]    = number_style
    styles[idx_montant_total] = number_style
    styles[idx_chorus]        = text_style
    styles[idx_marche]        = text_style
    styles[idx_tf]            = text_style

    types[idx_exercice]   = :integer
    types[idx_nb_actes]   = :integer
    types[idx_montant_ae] = :float
    types[idx_montant_total] = :float
    types[idx_delai]      = :integer

    sheet.add_row row_data, style: styles, types: types
  end

  sheet.column_widths *Array.new(headers.length, 15)
  last_col = Axlsx::col_ref(headers.size - 3)
  sheet.auto_filter = "A1:#{last_col}1"
end

# ─── Onglet T2 ──────────────────────────────────────────────────────────────
# Story 3.3 — Onglet dédié aux actes T2 avec les colonnes communes + les champs t2_details.
# Symétrie admin : la colonne "Controleur" est ajoutée en tête de ligne pour les admins,
# identique au sheet HT2.
t2_cols    = t2_export_columns
t2_indices = t2_export_column_indices

wb.add_worksheet(name: "T2") do |sheet|
  t2_headers = t2_cols.map { |(label, _)| label }
  t2_header_styles = t2_cols.map do |(_, perimetre)|
    case perimetre
    when :etat      then header_etat_style
    when :organisme then header_organisme_style
    else                 header_common_style
    end
  end

  if is_admin
    t2_headers = ['Controleur'] + t2_headers
    t2_header_styles = [header_common_style] + t2_header_styles
  end

  sheet.add_row t2_headers, style: t2_header_styles

  actes_t2.each do |acte|
    row_data = t2_export_row(acte)
    row_data = [acte.user.nom] + row_data if is_admin

    col_count = row_data.length
    styles = Array.new(col_count, cell_style)
    types  = Array.new(col_count, :string)

    offset = is_admin ? 1 : 0
    t2_indices[:float].each   { |i| styles[i + offset] = number_style; types[i + offset] = :float }
    t2_indices[:integer].each { |i| types[i + offset] = :integer }

    sheet.add_row row_data, style: styles, types: types
  end

  sheet.column_widths *Array.new(t2_headers.length, 15)
  last_col_t2 = Axlsx::col_ref(t2_headers.size - 1)
  sheet.auto_filter = "A1:#{last_col_t2}1"
end
