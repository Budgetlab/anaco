<%#
  Consultation complète d'un avis/note (rendu du tableau de bord BOP).
  Params :
    - avis     : l'objet Avi à afficher
    - editable : true si l'utilisateur courant peut modifier/reprendre cet avis
%>
<% is_avis = avis.phase == 'programmation initiale' || avis.phase == 'services votés' %>
<% brouillon = avis.etat == 'Brouillon' %>

<div data-controller="pdf-export">
  <div class="fr-callout fr-callout--brown-cafe-creme fr-mb-4w">
    <h3 class="fr-callout__title"><%= brouillon ? 'Brouillon en cours' : "#{is_avis ? 'Avis' : 'Note'}"%> <%= avis.phase_periode&.libelle_avec_numero || avis.phase %> <%= avis.annee %></h3>
    <div class="fr-btns-group fr-btns-group--inline fr-btns-group--icon-left">
      <% if editable %>
        <% if brouillon %>
          <%= link_to edit_bop_avi_path(bop_id: avis.bop_id, id: avis.id), class: "fr-btn" do %>
            Reprendre le brouillon
          <% end %>
          <%= link_to bop_avi_path(bop_id: avis.bop_id, id: avis.id),
                      class: "fr-btn fr-btn--secondary",
                      title: "Supprimer le brouillon",
                      data: { turbo_method: :delete, turbo_confirm: "Supprimer ce brouillon ?" } do %>Supprimer<% end %>
        <% else %>
          <%= link_to edit_bop_avi_path(bop_id: avis.bop_id, id: avis.id), class: "fr-btn" do %>
            Modifier
          <% end %>
        <% end %>

        <%= link_to 'Liste de travail', remplissage_avis_path, class: "fr-btn fr-btn--secondary" %>
      <% end %>
      <%= link_to "Historique des avis/notes", historique_path, class: "fr-btn fr-btn--secondary" %>
      <%= link_to "Historique du BOP", bop_path(avis.bop), class: "fr-btn fr-btn--secondary" %>
      <button type="button"
              class="fr-btn fr-btn--tertiary fr-btn--icon-left fr-icon-download-line"
              data-action="pdf-export#export"
              data-pdf-export-target="button"
              data-pdf-export-title="Avis_<%= avis.phase_periode&.libelle_avec_numero || avis.phase %>_<%= avis.annee %>_BOP_<%= avis.bop&.code %>.pdf">
        Exporter au format PDF
      </button>
    </div>
  </div>

  <div data-pdf-export-target="content">
    <h4 class="fr-mb-2w">
      <%= is_avis ? 'Avis' : 'Note' %> <%= avis.phase_periode&.libelle_avec_numero || avis.phase %> <%= avis.annee %> du BOP <%= avis.bop&.code %>
    </h4>

<% if avis.avis_recu == false %>
  <div class="fr-table fr-table--no-caption fr-mb-3w">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption>Statut de l'avis</caption>
            <thead>
            <tr>
              <th>Statut de l'avis</th>
              <th>Capacité à rendre l'avis</th>
              <th>Motif d'absence</th>
              <th>Date</th>
            </tr>
            </thead>
            <tbody>
            <tr>
              <td>
                <span class="<%= badge_class_for_statut(avis.statut) %> fr-badge--no-icon"><%= avis.statut.presence || 'Non renseigné' %></span>
              </td>
              <td>Non</td>
              <td class="fr-cell--multiline"><%= avis.motif_absence %></td>
              <td><%= l(avis.updated_at, format: "%e/%m/%y") %></td>
            </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <div class="fr-table fr-table--no-caption fr-mb-3w">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption>Statut de l'avis</caption>
            <thead>
            <tr>
              <% if avis.phase == 'services votés' %>
                <th>Statut de l'avis</th>
                <th>Date réception prévision des dépenses</th>
                <th>Date de l'avis</th>
                <th>Avis donné après suspension du délai</th>
              <% elsif avis.phase == 'programmation initiale' %>
                <th>Statut de l'avis</th>
                <th>Date réception BOP</th>
                <th>Date de l'avis</th>
                <th>Avis donné après suspension du délai</th>
                <th>CRG1 programmé</th>
              <% else %>
                <th>Risque d'insoutenabilité</th>
                <th>Date de la note d'analyse</th>
              <% end %>
              <th>Etat</th>
            </tr>
            </thead>
            <tbody>
            <tr>
              <td>
                <span class="<%= badge_class_for_statut(avis.statut) %> fr-badge--no-icon"><%= avis.statut.presence || 'Non renseigné' %></span>
              </td>
              <% if avis.phase == 'services votés' %>
                <td><%= format_date_text(avis.date_reception) %></td>
                <td><%= format_date_text(avis.date_envoi) %></td>
                <td><%= avis.is_delai == true ? 'Oui' : 'Non' %></td>
              <% elsif avis.phase == 'programmation initiale' %>
                <td><%= format_date_text(avis.date_reception) %></td>
                <td><%= format_date_text(avis.date_envoi) %></td>
                <td><%= avis.is_delai == true ? 'Oui' : 'Non' %></td>
                <td><%= avis.is_crg1 == true ? 'Oui' : 'Non' %></td>
              <% else %>
                <td><%= format_date_text(avis.date_envoi) %></td>
              <% end %>
              <td><p class="<%= badge_class_for_etat(avis.etat) %>"><%= avis.etat %></p></td>
            </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <% if avis.phase == 'services votés' %>
    <p class="fr-my-1w"><span class="fr-text--bold">Temporalité de la prévision des dépenses :</span> <%= avis.duree_prevision %>
      mois</p>
    <div class="fr-mb-3w">
      <%= render partial: "avis/rappel_chiffres", locals: { avis: [avis.ae_f, avis.cp_f, avis.t2_f, avis.etpt_f], titre: 'prév.', class_active: 'fr-card--orange' } %>
    </div>
  <% else %>
    <div class="fr-mt-2w">
      <%= render partial: "avis/rappel_chiffres", locals: { avis: [avis.ae_i, avis.cp_i, avis.t2_i, avis.etpt_i], titre: 'alloué', class_active: 'fr-card--green' } %>
    </div>
    <%= render partial: "avis/rappel_chiffres", locals: { avis: [avis.ae_f, avis.cp_f, avis.t2_f, avis.etpt_f], titre: 'prév.', class_active: 'fr-card--orange' } %>
    <div class="fr-mb-3w">
      <%= render partial: "avis/rappel_ecart", locals: { avis: avis } %>
    </div>
  <% end %>


  <div class="fr-text--bold fr-mt-2w"><%= avis.phase == 'CRG1' || avis.phase == 'CRG2' ? 'Observations' : "Développement synthétique sur l'avis" %></div>
  <div><%= auto_link(simple_format(format_value(avis.commentaire)), html: { target: '_blank' }) %></div>

<% end %>

<h5 class="fr-mt-4w fr-mb-2w">Informations générales sur le BOP <%= @bop.code %></h5>
<div class="fr-table fr-table--no-caption fr-mb-2w">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption>Informations générales sur le BOP</caption>
          <thead>
          <tr>
            <th>Ministère</th>
            <th>DCB responsable</th>
            <th>Programme</th>
            <th>Contrôleur</th>
            <th>Dotation</th>
          </tr>
          </thead>
          <tbody>
          <tr>
            <td class="fr-cell--multiline"><%= avis.bop&.programme&.ministere&.nom %></td>
            <td><%= avis.bop&.dcb&.nom %></td>
            <td>
              <% if avis.bop&.programme %>
                <%= link_to "Programme n°#{avis.bop.programme.numero}", programme_path(avis.bop.programme) %>
              <% end %>
            </td>
            <td><%= avis.bop&.user&.nom %></td>
            <td>
              <% if avis.bop&.dotation.present? %>
                <span class="fr-badge fr-badge--blue-ecume"><%= avis.bop.dotation %></span>
              <% end %></td>
          </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
  </div>
</div>

