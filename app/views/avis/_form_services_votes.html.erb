<div class="fr-mt-4w" data-controller="form conditional-field">
  <%= form_with(model: [@bop, @avis], data: { 'form-target': "form", action: "change->form#formChange input->form#formChange turbo:before-fetch-request->form#submitForm" }) do |f| %>
    <%= f.hidden_field :user_id, value: current_user.id %>
    <%= f.hidden_field :phase, value: 'services votés' %>
    <%= f.hidden_field :annee, value: @annee_a_afficher %>
    <%= f.hidden_field :ae_i, value: 0 %>
    <%= f.hidden_field :cp_i, value: 0 %>
    <%= f.hidden_field :t2_i, value: 0 %>
    <%= f.hidden_field :etpt_i, value: 0 %>
    <%= f.hidden_field :etat, value: "Brouillon", data: { 'form-target': 'etat' } %>

    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-lg-4">
        <%= render 'radio_oui_non',
              f: f, attribute: :avis_recu,
              legend: "Je suis en capacité de rendre mon analyse*",
              id_prefix: "avis-recu-sv", default: true,
              data: { action: "change->conditional-field#toggle",
                      conditional_field_target: "checkbox" } %>
        <div class="fr-select-group <%= 'fr-hidden' if (@avis.avis_recu.nil? || @avis.avis_recu) %>" data-conditional-field-target="field" data-inverse="true">
          <label for="avi-motif-absence-sv" class="fr-label">Motif d'absence*</label>
          <%= f.select :motif_absence,
                options_for_select(@liste_motifs, @avis.motif_absence),
                { include_blank: 'Sélectionner' },
                { id: 'avi-motif-absence-sv', class: 'fr-select', required: true } %>
        </div>
        <ul class="fr-btns-group fr-btns-group--inline fr-btns-group--right <%= 'fr-hidden' if (@avis.avis_recu.nil? || @avis.avis_recu) %>" data-conditional-field-target="field" data-inverse="true">
          <li>
            <%= f.submit "Valider", class: "fr-btn", data: { action: "click->form#validate" } %>
          </li>
        </ul>
      </div>
    </div>

    <div class="fr-grid-row fr-grid-row--gutters fr-mb-4w <%= 'fr-hidden' unless (@avis.avis_recu.nil? || @avis.avis_recu) %>" data-conditional-field-target="field">
      <div class="fr-col-12 fr-col-lg-4">
        <div class="fr-select-group">
          <label for="date_reception" class="fr-label">Date de réception de la prévision des dépenses*
            <span class="fr-hint-text">Indiquer ici la date de réception des documents finalisés</span>
          </label>
          <%= f.text_field :date_reception, class: "fr-select", required: true, data: { controller: "flatpickr", flatpickr_default_date: format_date(@avis.date_reception) }, value: format_date(@avis.date_reception), id: "date_reception", placeholder: "- sélectionner -" %>
        </div>
        <div class="fr-select-group">
          <label for="date_envoi" class="fr-label">Date de l’avis*
            <span class="fr-hint-text">Indiquer ici la date du courrier de l’envoi de l’avis</span></label>
          <%= f.text_field :date_envoi, class: "fr-select", required: true, data: { controller: "flatpickr", flatpickr_default_date: format_date(@avis.date_envoi) }, value: format_date(@avis.date_envoi), id: "date_envoi", placeholder: "- sélectionner -" %>
        </div>

        <%= render 'radio_oui_non',
              f: f, attribute: :is_delai,
              legend: "Avis donné après interruption du délai*",
              id_prefix: "radio-delai-sv", default: false %>

        <div class="fr-select-group">
          <label for="statut" class="fr-label">Sens de l'avis*</label>
          <%= f.select :statut, statuts_for_phase('services votés'), { include_blank: '- sélectionner -' }, { id: "statut", class: "fr-select", required: true } %>
        </div>
      </div>
      <div class="fr-col-12 fr-col-lg-8">
        <div class="fr-select-group">
          <label for="duree_prevision" class="fr-label">Durée retenue (1 à 12 mois)*</label>
          <%= f.select :duree_prevision, options_for_select((1..12).map { |n| [pluralize(n, "mois"), n] }, @avis.duree_prevision), {}, { id: "duree_prevision", class: "fr-select", required: true } %>
        </div>

        <div class="fr-accordion__title fr-mt-3w">Prévisions d'exécution sur cette durée (en €)
          <a class="fr-link" aria-describedby="prevision" id="link-prevision" href="#" data-controller="filter" data-action="filter#Dropdown">
            <span class="fr-icon-question-line fr-icon--sm" aria-hidden="true"></span>
          </a>
          <span class="fr-tooltip fr-placement" id="prevision" role="tooltip" aria-hidden="true">Niveau de consommation prévisionnelle des crédits et des emplois au 31 décembre de l’exercice tel que déclaré par le RBOP</span>
        </div>
        <hr class="fr-col_12">
        <div class="fr-grid-row fr-grid-row--gutters">
          <div class="fr-col-3">
            <div class="fr-input-group">
              <label class="fr-label" for="ae_f">
                AE HT2
              </label>
              <% if @bop.dotation != "T2" %>
                <%= f.text_field :ae_f, data: { action: 'input->form#changeNumber' }, class: "fr-input", id: "ae_f" %>
              <% else %>
                <%= f.text_field :ae_f, class: "fr-input", id: "ae_f", value: 0, disabled: true %>
                <%= f.hidden_field :ae_f, value: 0 %>
              <% end %>
            </div>
          </div>
          <div class="fr-col-3">
            <div class="fr-input-group">
              <label class="fr-label" for="cp_f">
                CP HT2
              </label>
              <% if @bop.dotation != "T2" %>
                <%= f.text_field :cp_f, data: { action: 'input->form#changeNumber' }, class: "fr-input", id: "cp_f" %>
              <% else %>
                <%= f.text_field :cp_f, class: "fr-input", id: "cp_f", value: 0, disabled: true %>
                <%= f.hidden_field :cp_f, value: 0 %>
              <% end %>
            </div>
          </div>
          <div class="fr-col-3">
            <div class="fr-input-group">
              <label class="fr-label" for="t2_f">
                AE/CP T2
              </label>
              <% if @bop.dotation != "HT2" %>
                <%= f.text_field :t2_f, data: { action: 'input->form#changeNumber' }, class: "fr-input", id: "t2_f" %>
              <% else %>
                <%= f.text_field :t2_f, class: "fr-input", id: "t2_f", value: 0, disabled: true %>
                <%= f.hidden_field :t2_f, value: 0 %>
              <% end %>
            </div>
          </div>
          <div class="fr-col-3">
            <div class="fr-input-group">
              <label class="fr-label" for="etpt_f">
                ETPT
              </label>
              <% if @bop.dotation != "HT2" %>
                <%= f.text_field :etpt_f, data: { action: 'input->form#changeNumber' }, class: "fr-input", id: "etpt_f" %>
              <% else %>
                <%= f.text_field :etpt_f, class: "fr-input", id: "etpt_f", value: 0, disabled: true %>
                <%= f.hidden_field :etpt_f, value: 0 %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="fr-input-group fr-mt-3w">
          <label class="fr-label" for="commentaire">
            Développements synthétiques sur l’avis (destinés à un usage interne)
            <span class="fr-hint-text">800 caractères recommandés, espaces compris</span>
          </label>
          <%= f.text_area :commentaire, data: { action: "input->form#calculNombreCaracteres" }, class: "fr-input", id: "commentaire", rows: 10 %>
          <p class="fr-message fr-message--info"><span class="fr-mr-1v" data-form-target="count">0 </span> caractères
          </p>
        </div>

        <ul class="fr-btns-group fr-btns-group--icon-left fr-btns-group--inline fr-btns-group--right">
          <li>
            <button class="fr-btn fr-icon-save-3-fill fr-btn--icon-left fr-btn--secondary" data-fr-opened="false" aria-controls="modal-1123" data-action="click->form#save">
              Enregistrer en brouillon
            </button>
          </li>
          <li>
            <%= f.submit "Valider", class: "fr-btn", data: { action: "click->form#validate" } %>
          </li>
        </ul>
      </div>
    </div>

    <%= render 'form_modals', f: f %>
  <% end %>
</div>

