<%# Radio Oui/Non DSFR pour un attribut booléen.
    Locals :
      f          : form builder
      attribute  : symbole de l'attribut (ex: :is_delai)
      legend     : libellé du fieldset (ex: "Avis donné après interruption du délai*")
      id_prefix  : préfixe des id radio (ex: "radio-delai" → "radio-delai-oui" / "radio-delai-non")
      default    : true | false → valeur par défaut quand l'attribut est nil
      data       : (optionnel) hash data-* à poser sur chaque input radio
%>
<% effective = f.object.public_send(attribute).nil? ? default : f.object.public_send(attribute) %>
<% data_attrs = local_assigns[:data] || {} %>
<fieldset class="fr-fieldset fr-mb-3w">
  <legend class="fr-fieldset__legend--regular fr-fieldset__legend fr-mb-1w">
    <%= legend %>
  </legend>
  <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
    <div class="fr-radio-group">
      <%= f.radio_button attribute, true, id: "#{id_prefix}-oui", checked: effective == true, data: data_attrs %>
      <label class="fr-label" for="<%= id_prefix %>-oui">Oui</label>
    </div>
  </div>
  <div class="fr-fieldset__element fr-fieldset__element--inline fr-mb-0">
    <div class="fr-radio-group">
      <%= f.radio_button attribute, false, id: "#{id_prefix}-non", checked: effective == false, data: data_attrs %>
      <label class="fr-label" for="<%= id_prefix %>-non">Non</label>
    </div>
  </div>
</fieldset>
