<% content_for :title do %>Formulaire modification d'avis | ANACO
<% end %>
<main role="main" class="containtAll">
  <div class="fr-container" data-controller="form">
    <nav role="navigation" class="fr-breadcrumb" aria-label="vous êtes ici :">
      <button class="fr-breadcrumb__button " aria-expanded="false" aria-controls="breadcrumb-1" title="voir le fil d'ariane">
        Voir le fil d’Ariane
      </button>
      <div class="fr-collapse" id="breadcrumb-1">
        <ol class="fr-breadcrumb__list">
          <li>
            <%= link_to root_path, class: "fr-breadcrumb__link" do %> Accueil
            <% end %>
          </li>
          <li>
            <%= link_to remplissage_avis_path, class: "fr-breadcrumb__link" do %> Remplissage des avis/notes
            <% end %>
          </li>
          <li>
            <a class="fr-breadcrumb__link" aria-current="page">Formulaire <%= @phase_form %></a>
          </li>
        </ol>
      </div>
    </nav>
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12 fr-col-lg-12">
        <h1>Formulaire <%= @phase_form %> <%= @annee_a_afficher %></h1>
        <div class="title-btn">
          <div class="fr-h3 fr-mb-0">BOP n°<%= @bop.code %></div>
          <button aria-controls="modal-quitter" data-fr-opened="false" type="button" class="fr-link fr-icon-close-line fr-link--icon-right">Quitter le formulaire</button>
        </div>
        <div>
          <p class="fr-badge fr-badge--sm fr-badge--blue-ecume">
            BOP doté en <%= @bop.dotation %>
          </p>
          <% if @phase_form == 'début de gestion' || @phase_form == 'services votés' %>
            <%= link_to edit_bop_path(@bop), class: "fr-btn fr-btn--secondary fr-btn--sm fr-btn--icon-left fr-icon-edit-line" do %>
              Modifier
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <dialog id="modal-quitter" class="fr-modal" aria-labelledby="modal-quitter-title" data-fr-concealing-backdrop="true">
      <div class="fr-container fr-container--fluid fr-container-md">
        <div class="fr-grid-row fr-grid-row--center">
          <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
            <div class="fr-modal__body">
              <div class="fr-modal__header">
                <button aria-controls="modal-quitter" title="Fermer" type="button" class="fr-btn--close fr-btn">Fermer</button>
              </div>
              <div class="fr-modal__content">
                <h2 id="modal-quitter-title" class="fr-modal__title">
                  Quitter le formulaire
                </h2>
                <div class="fr-alert fr-alert--warning fr-mb-4w">
                  <h3 class="fr-alert__title">Vous êtes sur la point de quitter le formulaire.</h3>
                  <p>Les données modifiées ne seront pas sauvegardées. Êtes-vous sûrs de vouloir continuer ?</p>
                </div>
                <ul class="fr-btns-group fr-btns-group--inline">
                  <li>
                    <%= link_to remplissage_avis_path, class: "fr-btn" do %>
                      Quitter le formulaire
                    <% end %>
                  </li>
                  <li>
                    <button class="fr-btn fr-btn--secondary" aria-controls="modal-quitter">
                      Annuler
                    </button>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </dialog>
    <div class="cwarning">Tous les champs comportant un astérisque (*) sont à remplir obligatoirement.</div>
    <% if @phase_form == "services votés" %>
      <%= render 'form_services_votes' %>
    <% elsif @phase_form == "début de gestion" %>
      <%= render 'form_debut' %>
    <% elsif @phase_form == "CRG1" %>
      <%= render 'form_crg1' %>
    <% elsif @phase_form == "CRG2" %>
      <%= render 'form_crg2' %>
    <% end %>
  </div>
</main>