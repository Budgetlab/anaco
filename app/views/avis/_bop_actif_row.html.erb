<%# Ligne du tableau de remplissage pour un BOP actif.
    Locals :
      bop, avis_par_bop, annee_affichee
    Le calendrier des phases est lu via les helpers (Phase via la table).
    Chaque cellule de phase peut contenir N badges si plusieurs instances de la phase
    coexistent dans l'année (cas SV1/SV2).
%>
<% avis_bop       = avis_par_bop[bop.id] || [] %>
<% avis_debut     = avis_bop.find { |a| a.phase == 'programmation initiale' } %>
<% phases_par_nom = phases_groupees_par_nom(annee_affichee) %>
<% next_phase     = next_phase_to_fill(avis_bop, annee_affichee) %>

<tr>
  <td><%= link_to "#{bop.code}", bop_path(bop) %></td>

  <% noms_phases_pour_annee(annee_affichee).each do |nom| %>
    <td>
      <% instances = phases_par_nom[nom] || [] %>
      <% if instances.empty? %>
        <%# Phase absente du calendrier de l'année (ex: SV en 2024) → "Non ouvert". %>
        <%= phase_status_badge(nil, nom, false) %>
      <% else %>
        <% instances.each do |phase| %>
          <% avis      = avis_pour_phase(avis_bop, phase) %>
          <% prefixe   = instances.size > 1 ? phase.libelle_court_avec_numero : nil %>
          <div class="fr-mb-1v">
            <%= phase_status_badge(avis, nom, phase.ouverte?, avis_debut: avis_debut, prefix: prefixe) %>
          </div>
        <% end %>
      <% end %>
    </td>
  <% end %>

  <td>
    <% if next_phase %>
      <%= link_to new_bop_avi_path(bop_id: bop),
                  class: "fr-btn fr-btn--icon-left fr-icon-edit-line" do %>
        Rédiger
      <% end %>
    <% else %>
      <button class="fr-btn fr-btn--icon-left fr-icon-edit-line" disabled>Rédiger</button>
    <% end %>
  </td>
  <td>
    <% dernier_avis = avis_bop.max_by(&:created_at) %>
    <% if dernier_avis %>
      <%= link_to "Consulter les avis", consultation_bop_avis_path(dernier_avis), class: "fr-btn fr-btn--secondary" %>
    <% end %>
  </td>
</tr>
