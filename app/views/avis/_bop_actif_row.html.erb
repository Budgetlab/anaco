<%# Ligne du tableau de remplissage pour un BOP actif.
    Locals :
      bop, avis_par_bop, annee_affichee, annee,
      date_debut, date_crg1, date_crg2
%>
<% avis_bop    = avis_par_bop[bop.id] || [] %>
<% avis_sv     = avis_bop.select { |a| a.phase == 'services votés' }.max_by(&:created_at) %>
<% avis_debut  = avis_bop.find   { |a| a.phase == 'début de gestion' } %>
<% avis_crg1   = avis_bop.find   { |a| a.phase == 'CRG1' } %>
<% avis_crg2   = avis_bop.find   { |a| a.phase == 'CRG2' } %>
<% dates       = [annee_affichee, annee, date_debut, date_crg1, date_crg2] %>
<% next_phase  = next_phase_to_fill(avis_bop, *dates) %>

<tr>
  <td><%= link_to "BOP #{bop.code}", bop_path(bop) %></td>
  <td><%= phase_status_badge(avis_sv,    'services votés',   phase_ouverte?('services votés',   *dates)) %></td>
  <td><%= phase_status_badge(avis_debut, 'début de gestion', phase_ouverte?('début de gestion', *dates)) %></td>
  <td><%= phase_status_badge(avis_crg1,  'CRG1',             phase_ouverte?('CRG1',             *dates), avis_debut: avis_debut) %></td>
  <td><%= phase_status_badge(avis_crg2,  'CRG2',             phase_ouverte?('CRG2',             *dates)) %></td>
  <td>
    <% if next_phase %>
      <%= link_to new_bop_avi_path(bop_id: bop, date: annee_affichee, phase: next_phase),
                  class: "fr-btn fr-btn--icon-left fr-icon-edit-line" do %>
        Rédiger
      <% end %>
    <% else %>
      <button class="fr-btn fr-btn--icon-left fr-icon-edit-line" disabled>Rédiger</button>
    <% end %>
  </td>
  <td>
    <%= link_to "Consulter les avis", bop_path(bop), class: "fr-btn fr-btn--secondary" %>
  </td>
</tr>
