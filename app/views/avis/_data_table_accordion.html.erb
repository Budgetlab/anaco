<%#
  Tableau des données sous un graphe, au style du tableau de bord actes.
  Params :
    - id      : identifiant unique pour aria-controls
    - caption : légende du tableau (lecteurs d'écran)
    - headers : tableau d'intitulés de colonnes
    - rows    : tableau de lignes, chaque ligne = tableau de cellules
    - total_row (optionnel) : tableau de cellules pour la ligne Total
%>
<section class="fr-accordion">
  <h3 class="fr-accordion__title">
    <button type="button" class="fr-accordion__btn" aria-expanded="false" aria-controls="<%= id %>">Tableau des données</button>
  </h3>
  <div class="fr-collapse" id="<%= id %>">
    <div class="fr-table">
      <div class="fr-table__wrapper">
        <div class="fr-table__container">
          <div class="fr-table__content">
            <table>
              <caption><%= caption %></caption>
              <thead>
                <tr>
                  <% headers.each do |header| %>
                    <th><%= header %></th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |row| %>
                  <tr>
                    <% row.each_with_index do |cell, i| %>
                      <td class="<%= i.zero? ? 'fr-cell--multiline' : '' %>"><%= cell %></td>
                    <% end %>
                  </tr>
                <% end %>
                <% if local_assigns[:total_row].present? %>
                  <tr class="fr-table--total">
                    <% total_row.each do |cell| %>
                      <td><%= cell %></td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
