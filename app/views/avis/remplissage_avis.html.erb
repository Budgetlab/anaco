<% content_for :title do %>Liste de travail avis/notes | ANACO
<% end %>

<div class="fr-container">
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-lg-12">
      <h1 class="fr-mt-6w fr-mb-2w title-btn">
        Liste de travail avis/notes <%= @annee %>
      </h1>

      <h2 class='fr-h3'>Nous sommes en phase de <%= @phase_courante %></h2>

      <div class="fr-grid-row fr-grid-row--gutters fr-mb-2w">
        <div class="fr-col-lg-1 fr-col-2"><%= image_tag "artwork/pictograms/document/document-download.svg", alt: "" %></div>
        <div class="fr-col-lg-11 fr-col-10">
          <div class="fr-text--lg fr-mt-1w">Les avis et notes CRG complets et adressés aux ordonnateurs sont à déposer
            sur Resana dans le dossier vous concernant.<br>
            <a href='https://resana.numerique.gouv.fr/public/perimetre/consulter/277653' target="_blank" class="fr-link fr-link--lg fr-icon-arrow-right-line fr-link--icon-right">Cliquez
              ici pour y accéder</a></div>
        </div>
      </div>
    </div>
  </div>

  <%= render partial: 'bops/notice' %>
  <%= render 'avis/success' %>

  <div class="fr-tabs fr-mb-2w">
    <ul class="fr-tabs__list" role="tablist" aria-label="Onglets BOP actifs et archivés">
      <li role="presentation">
        <button id="tabpanel-1177" class="fr-tabs__tab" tabindex="0" role="tab" aria-selected="true" aria-controls="tabpanel-1177-panel">BOP
          actifs (<%= @bops_actifs.count %>)
        </button>
      </li>
      <li role="presentation">
        <button id="tabpanel-1178" class="fr-tabs__tab" tabindex="-1" role="tab" aria-selected="false" aria-controls="tabpanel-1178-panel">BOP
          inactifs (<%= @bops_inactifs.count %>)
        </button>
      </li>
    </ul>
    <div id="tabpanel-1177-panel" class="fr-tabs__panel fr-tabs__panel--selected" role="tabpanel" aria-labelledby="tabpanel-1177" tabindex="0">
      <div class="fr-notice fr-notice--warning fr-mb-2w">
        <div class="fr-container">
          <div class="fr-notice__body">
            <p>
              <span class="fr-notice__title">Il reste <%= pluralize(current_user.avis_a_remplir(@annee_a_afficher), 'avis/note', plural: 'avis/notes') %>
                à rédiger</span>
            </p>
          </div>
        </div>
      </div>

      <div class="fr-table">
        <div class="fr-table__wrapper">
          <div class="fr-table__container">
            <div class="fr-table__content">
              <table>
                <caption class="fr-sr-only">Avancement du remplissage des avis par BOP et par phase</caption>
                <thead>
                <tr>
                  <th scope="col">BOP</th>
                  <% noms_phases_pour_annee(@annee_a_afficher).each do |nom| %>
                    <th scope="col"><%= Phase.libelle_colonne(nom) %></th>
                  <% end %>
                  <th scope="col"><span class="fr-sr-only">Rédiger</span></th>
                  <th scope="col"><span class="fr-sr-only">Consulter</span></th>
                </tr>
                </thead>
                <tbody>
                <% @bops_actifs&.each do |bop| %>
                  <%= render 'bop_actif_row',
                             bop: bop,
                             avis_par_bop: @avis_par_bop,
                             annee_affichee: @annee_a_afficher %>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="tabpanel-1178-panel" class="fr-tabs__panel" role="tabpanel" aria-labelledby="tabpanel-1178" tabindex="0">
      <div class="fr-table fr-table--no-scroll">
        <div class="fr-table__wrapper">
          <div class="fr-table__container">
            <div class="fr-table__content">
              <table>
                <caption class="fr-sr-only">BOP inactifs</caption>
                <thead>
                <tr>
                  <th scope="col">BOP</th>
                  <th scope="col">Programme</th>
                  <th scope="col">Statut</th>
                  <% if @annee_a_afficher == @annee %>
                    <th scope="col"></th>
                  <% end %>
                  <th scope="col"></th>
                </tr>
                </thead>
                <tbody>
                <% @bops_inactifs&.each do |bop| %>
                  <tr>
                    <td><%= link_to bop_path(bop) do %><%= bop.code %>
                      <% end %></td>
                    <td><%= link_to "#{bop.programme.numero} - #{bop.programme.nom}", programme_path(bop.programme) %></td>
                    <td><p class="fr-badge">Inactif</p></td>
                    <% if @annee_a_afficher == @annee %>
                      <td>
                        <%= link_to edit_bop_path(bop), class: "fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-edit-line" do %>
                          Modifier la dotation
                        <% end %>
                      </td>
                    <% end %>
                    <td><%= link_to bop_path(bop), class: "fr-btn " do %>
                        Consulter
                      <% end %></td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
